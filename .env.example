# Server & Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"

# Security & Authentication (Phase 0 & Phase 1)
# Generate 32-byte secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
CSRF_SECRET=""
DATA_ENCRYPTION_KEY=""
EXPORT_TOKEN=""
TRUSTED_PROXY="false"

# Gemini AI Configuration (H-03, M-05, L-03)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_REASONING_MODEL="gemini-3-flash-preview"
GEMINI_OCR_MODEL="gemini-3.1-flash-lite-preview"
GEMINI_TIMEOUT_MS=5000
GEMINI_MEDIA_TIMEOUT_MS=20000

# Telegram Bot & Webhook Configuration (C-03, H-05)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Persistence Directory (defaults to os.tmpdir()/dhaal-data at runtime)
DHAAL_DATA_DIR=""
